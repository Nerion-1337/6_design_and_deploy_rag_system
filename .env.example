# Choix du fournisseur LLM (gratuit) : "nvidia" ou "huggingface_local"
RAG_LLM_PROVIDER=nvidia ou huggingface_local

# Clé API NVIDIA NIM (gratuite sur https://build.nvidia.com)
# Requise uniquement si RAG_LLM_PROVIDER=nvidia
NVIDIA_API_KEY=

# Modèle NVIDIA NIM utilisé (catalogue gratuit)
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Modèle Hugging Face local utilisé si RAG_LLM_PROVIDER=huggingface_local
# (aucune clé API requise, s'exécute entièrement en local)
HF_LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Modèle d'embeddings local (gratuit, tourne sur CPU, aucune clé requise)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
